#####################################
### GENERAL ENVIRONMENT VARIABLES ###
#####################################

# Clickhouse database
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=password
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

CLICKHOUSE_BACKEND_USER=backend
CLICKHOUSE_BACKEND_PASSWORD=password

CLICKHOUSE_DASHBOARD_USER=dashboard
CLICKHOUSE_DASHBOARD_PASSWORD=password

WORKER_CLICKHOUSE_WRITE_USER=worker
WORKER_CLICKHOUSE_WRITE_PASSWORD=password

# Postgres database
# Set POSTGRES_HOST_PORT if the default 5432 conflicts with a local Postgres instance.
# If changed, also update the port in POSTGRES_URL, SITE_CONFIG_DATABASE_URL, SALTS_DATABASE_URL, MONITORING_DATABASE_URL, and JOB_QUEUE_DATABASE_URL below.
# POSTGRES_HOST_PORT=5433
POSTGRES_URL="postgresql://user:password@localhost:5432/dashboard?schema=public"
POSTGRES_DB=dashboard
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Postgres database - SiteConfig table read-only user
SITE_CONFIG_DATABASE_URL="postgresql://siteconfig_ro:CHANGE_ME_STRONG@localhost:5432/dashboard"
POSTGRES_SITECONFIG_RO_PASSWORD=CHANGE_ME_STRONG

# Postgres database - AnalyticsSalt table read-write user (fingerprint anonymization salts)
SALTS_DATABASE_URL="postgresql://salts_rw:CHANGE_ME_STRONG@localhost:5432/dashboard"
POSTGRES_SALTS_RW_PASSWORD=CHANGE_ME_STRONG

# Postgres database - Monitor table read-only user
ENABLE_UPTIME_MONITORING=false
# Public status pages (requires ENABLE_UPTIME_MONITORING)
ENABLE_PUBLIC_STATUS_PAGES=false
MONITORING_DATABASE_URL="postgresql://monitoring_ro:CHANGE_ME_STRONG@localhost:5432/dashboard"
POSTGRES_MONITORING_RO_PASSWORD=CHANGE_ME_STRONG

# Postgres database - pgboss schema read-write user
JOB_QUEUE_DATABASE_URL="postgresql://jobqueue_rw:CHANGE_ME_STRONG@localhost:5432/dashboard"
POSTGRES_JOBQUEUE_RW_PASSWORD=CHANGE_ME_STRONG

IS_DEVELOPMENT=true


#####################################
### BACKEND ENVIRONMENT VARIABLES ###
#####################################

SERVER_HOST="127.0.0.1"
SERVER_PORT=3001

LOG_LEVEL=debug

ENABLE_GEOLOCATION=false
GEOLOCATION_MODE=country # country | full
MAXMIND_ACCOUNT_ID=xxxxx
MAXMIND_LICENSE_KEY=xxxxx

# IP->ASN resolution for bot detection (downloads GeoLite2-ASN, requires MaxMind credentials)
ENABLE_ASN_LOOKUP=false
# Persist detected bot signals to analytics.bot_events (rule-tuning telemetry)
ENABLE_BOT_EVENT_LOG=false

DATA_RETENTION_DAYS=365 # Number of days to keep data in the database. Use -1 to keep data indefinitely

ENABLE_BILLING=false

SESSION_REPLAYS_ENABLED=false

# S3 storage used for Session Replays
S3_ENABLED=false
S3_BUCKET=betterlytics-replays
S3_REGION="eu-central-1"
S3_ENDPOINT=http://localhost:9001
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
s3_sse_enabled=false


#######################################
### DASHBOARD ENVIRONMENT VARIABLES ###
#######################################

PUBLIC_BASE_URL=http://localhost:3000

# Auth
AUTH_URL=http://localhost:3000
AUTH_SECRET=your-secret

# Dashboard default user credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# Dashboard default language
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Used for /analytics.js
PUBLIC_ANALYTICS_BASE_URL="http://localhost:3006"

# Used for /event
PUBLIC_TRACKING_SERVER_ENDPOINT="http://localhost:3001"

# Feature flags
ENABLE_DASHBOARD_TRACKING=true
ENABLE_REGISTRATION=false

# Set to false to stop fetching domain favicons from icons.duckduckgo.com
PUBLIC_ENABLE_FAVICON_FETCHING=true

PUBLIC_IS_CLOUD=false
IS_CLOUD=false

# Mail settings
ENABLE_EMAILS=false
MAILER_SEND_API_TOKEN=''

# Monitoring
ENABLE_MONITORING=false

# OAuth
GITHUB_ID=
GITHUB_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

BACKGROUND_JOBS_ENABLED=false

# Integrations - Register an app at https://pushover.net/apps to get an API token
PUSHOVER_APP_TOKEN=
INTEGRATION_ENCRYPTION_KEY=your-32-character-encryption-key

# Public status pages. Host routing for custom status domains lives in the app itself and needs
# no proxy config. STATUS_PAGE_ASK_SECRET is required whenever public status pages are enabled
# outside development (the selfhost setup derives it) and is used only by a proxy doing on-demand
# TLS through /api/status-page/ask.
STATUS_PAGE_DOMAIN=status.localhost
# STATUS_PAGE_ASK_SECRET=
