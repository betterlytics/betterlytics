#####################################
### GENERAL ENVIRONMENT VARIABLES ###
#####################################

# Clickhouse database
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=password
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

CLICKHOUSE_BACKEND_USER=backend
CLICKHOUSE_BACKEND_PASSWORD=password

CLICKHOUSE_DASHBOARD_USER=dashboard
CLICKHOUSE_DASHBOARD_PASSWORD=password

# Postgres database
# Set POSTGRES_HOST_PORT if the default 5432 conflicts with a local Postgres instance.
# If changed, also update the port in POSTGRES_URL, SITE_CONFIG_DATABASE_URL, SALTS_DATABASE_URL, MONITORING_DATABASE_URL, and JOB_QUEUE_DATABASE_URL below.
# POSTGRES_HOST_PORT=5433
POSTGRES_URL="postgresql://user:password@localhost:5432/dashboard?schema=public"
POSTGRES_DB=dashboard
POSTGRES_USER=user
POSTGRES_PASSWORD=password

SITE_CONFIG_DATABASE_URL="postgresql://siteconfig_ro:password@localhost:5432/dashboard"
POSTGRES_SITECONFIG_RO_PASSWORD=password

SALTS_DATABASE_URL="postgresql://salts_rw:password@localhost:5432/dashboard"
POSTGRES_SALTS_RW_PASSWORD=password

ENABLE_UPTIME_MONITORING=false
ENABLE_PUBLIC_STATUS_PAGES=false
MONITORING_DATABASE_URL="postgresql://monitoring_ro:password@localhost:5432/dashboard"
POSTGRES_MONITORING_RO_PASSWORD=password

JOB_QUEUE_DATABASE_URL="postgresql://jobqueue_rw:password@localhost:5432/dashboard"
POSTGRES_JOBQUEUE_RW_PASSWORD=password


#####################################
### BACKEND ENVIRONMENT VARIABLES ###
#####################################

SERVER_HOST="0.0.0.0"
SERVER_PORT=3001

LOG_LEVEL=debug

ENABLE_GEOLOCATION=false
GEOLOCATION_MODE=country # country | full
MAXMIND_ACCOUNT_ID=xxxxx
MAXMIND_LICENSE_KEY=xxxxx

DATA_RETENTION_DAYS=365 # Number of days to keep data in the database. Use -1 to keep data indefinitely
# REPLAY_RETENTION_DAYS=60 # Days to keep session replays (default 60). Use -1 to keep replays indefinitely. Applies to ClickHouse data only; with S3 storage, expire the site/ prefix with your own bucket lifecycle rule



#######################################
### DASHBOARD ENVIRONMENT VARIABLES ###
#######################################

PUBLIC_BASE_URL=https://betterlytics.io

# Auth requisites
AUTH_URL=https://betterlytics.io
AUTH_SECRET=your-secret

# Used for /analytics.js
PUBLIC_ANALYTICS_BASE_URL="https://betterlytics.io"

# Used for /event
PUBLIC_TRACKING_SERVER_ENDPOINT="https://betterlytics.io"

# Dashboard default user credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# Dashboard default language
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Feature flags
ENABLE_REGISTRATION=false

# Mail settings
ENABLE_EMAILS=false
MAILER_SEND_API_TOKEN=''

# Integrations
INTEGRATION_ENCRYPTION_KEY=your-32-character-encryption-key

# OAuth
GITHUB_ID=
GITHUB_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Replays
SESSION_REPLAYS_ENABLED=false
# Where replay segments are stored: "clickhouse" (default, no extra services) or "s3".
# Unset resolves to s3 when S3_ENABLED=true, else clickhouse. The S3 block (S3_BUCKET,
# S3_ENDPOINT, credentials) is only required for REPLAY_STORAGE=s3; S3_ENDPOINT only
# needs to be reachable from the backend/dashboard containers, never from browsers.
REPLAY_STORAGE=clickhouse
S3_ENABLED=false

# Integrations - Register an app at https://pushover.net/apps to get an API token
PUSHOVER_APP_TOKEN=

# Public status pages. The ask secret must match the
# one the proxy sends — required when status pages are enabled; generate with: openssl rand -hex 32
STATUS_PAGE_DOMAIN=status.betterlytics.io
STATUS_PAGE_ASK_SECRET=
ENABLE_PUBLIC_STATUS_PAGES=true
